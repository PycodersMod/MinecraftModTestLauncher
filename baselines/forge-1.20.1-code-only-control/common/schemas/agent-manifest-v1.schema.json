{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pycodersmod.github.io/mmtl/schemas/agent-manifest-v1.schema.json",
  "title": "MMTL Agent Provider Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "loaderId", "minecraftVersions", "agentVersion", "artifact", "sha256", "minJavaMajor", "roles", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "loaderId": { "enum": ["Forge", "Fabric", "NeoForge", "Quilt"] },
    "minecraftVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" } },
    "agentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "artifact": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "minJavaMajor": { "type": "integer", "minimum": 1 },
    "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["Client", "Host", "Guest", "Server"] } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$" } }
  }
}
