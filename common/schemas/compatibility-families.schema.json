{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/compatibility-families.schema.json",
  "title": "MMTL Exact Compatibility Families",
  "type": "object",
  "required": ["schemaVersion", "auditStatus", "universeHash", "families", "unassignedTargetPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "auditStatus": { "enum": ["IN_PROGRESS", "FROZEN"] },
    "universeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "families": { "type": "array", "items": { "$ref": "#/$defs/family" } },
    "unassignedTargetPolicy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "family": {
      "type": "object",
      "required": ["familyId", "loaderId", "minecraftIds", "toolchain", "buildJava", "runtimeJava", "projectDetectionStrategy", "launchStrategy", "agentBridge", "evidence"],
      "properties": {
        "familyId": { "type": "string", "minLength": 1 },
        "loaderId": { "type": "string", "minLength": 1 },
        "minecraftIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "toolchain": {},
        "buildJava": {},
        "runtimeJava": {},
        "projectDetectionStrategy": { "type": "string", "minLength": 1 },
        "launchStrategy": { "type": "string", "minLength": 1 },
        "agentBridge": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
