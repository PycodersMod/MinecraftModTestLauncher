{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/compatibility-matrix.schema.json",
  "title": "MMTL 兼容性矩阵 v1",
  "description": "分别记录上游来源、已解析目标、能力和 MMTL 验证证据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "minecraft", "loaderStack", "toolchain", "buildSystem", "java", "target", "validation", "provenance", "notes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "minecraft": {"$ref": "#/definitions/minecraft"},
    "loaderStack": {"$ref": "#/definitions/loaderStack"},
    "toolchain": {"$ref": "#/definitions/toolchain"},
    "buildSystem": {"$ref": "#/definitions/buildSystem"},
    "java": {"type": "object", "additionalProperties": false, "required": ["build", "runtime"], "properties": {"build": {"$ref": "#/definitions/javaRequirement"}, "runtime": {"$ref": "#/definitions/javaRequirement"}}},
    "target": {"$ref": "#/definitions/target"},
    "validation": {"$ref": "#/definitions/validation"},
    "provenance": {"type": "array", "items": {"$ref": "#/definitions/provenance"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceType", "url", "fetchedAt"],
      "properties": {
        "sourceType": {"enum": ["official", "archivedOfficial", "trustedArchive", "communityMirror", "unknown"]},
        "url": {"type": "string", "format": "uri"},
        "fetchedAt": {"type": "string", "format": "date-time"},
        "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "archiveStatus": {"enum": ["active", "archived", "unverified", "unknown"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "minecraft": {
      "type": "object", "additionalProperties": false, "required": ["id", "channel", "releaseTime", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "channel": {"enum": ["release", "snapshot", "prerelease", "rc"]},
        "releaseTime": {"type": "string", "format": "date-time"},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/provenance"}}
      }
    },
    "loaderIdentity": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "role", "provenance"],
      "properties": {
        "id": {"enum": ["Forge", "Fabric", "NeoForge", "Quilt", "LegacyFabric", "OrnitheLoader", "LiteLoader", "Rift", "ModLoader", "ModLoaderMP", "JarMod"]},
        "version": {"type": "string", "minLength": 1},
        "role": {"enum": ["Primary", "Overlay"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/provenance"}}
      }
    },
    "loaderStack": {
      "type": "object", "additionalProperties": false, "required": ["primaryLoader", "overlayLoaders"],
      "properties": {
        "primaryLoader": {"allOf": [{"$ref": "#/definitions/loaderIdentity"}, {"properties": {"role": {"const": "Primary"}}}]},
        "overlayLoaders": {"type": "array", "items": {"allOf": [{"$ref": "#/definitions/loaderIdentity"}, {"properties": {"role": {"const": "Overlay"}}}]}}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"enum": ["ForgeGradle", "FabricLoom", "NeoGradle", "ModDevGradle", "QuiltLoom", "Ploceus", "LegacyLooming", "Unknown", "Custom"]},
        "version": {"type": "string"},
        "ecosystem": {"type": "string", "description": "可选的生态背景信息，例如 Ornithe；这不是 Loader 身份。"}
      }
    },
    "buildSystem": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"enum": ["GradleWrapper", "Custom", "Legacy"]}, "version": {"type": "string"}}
    },
    "javaRequirement": {
      "type": "object", "additionalProperties": false, "required": ["major", "source", "confidence"],
      "properties": {
        "major": {"type": ["integer", "null"], "minimum": 1},
        "exactVersion": {"type": "string"},
        "home": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["High", "Medium", "Low", "Unknown"]},
        "requirementKind": {"enum": ["Minimum", "Preferred", "Exact", "Unknown", "AuthoritativeMetadata", "OfficialReleaseRequirement", "CompatibilityFallback", "ProjectOverride", "ToolchainRequirement"]},
        "requirementSourceKind": {"type": "string"},
        "minimumMajor": {"type": ["integer", "null"], "minimum": 1},
        "maximumMajor": {"type": ["integer", "null"], "minimum": 1},
        "preferredMajor": {"type": ["integer", "null"], "minimum": 1},
        "exactMajor": {"type": ["integer", "null"], "minimum": 1},
        "purpose": {"enum": ["BuildJava", "RuntimeJava"]},
        "vendor": {"type": "string"},
        "arch": {"enum": ["x64", "ARM64"]}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["os", "arch", "capability"],
      "properties": {
        "os": {"enum": ["Windows", "Linux", "MacOS"]},
        "arch": {"enum": ["x64", "ARM64"]},
        "capability": {"enum": ["Native", "Compatibility", "BuildOnly", "Unsupported"]}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["level", "result", "lastVerified", "evidence"],
        "properties": {
        "level": {"enum": ["CATALOGUED", "RESOLVED", "BUILD_VERIFIED", "SERVER_VERIFIED", "CLIENT_LAUNCH_VERIFIED", "INTEGRATION_VERIFIED"]},
        "result": {"enum": ["UNVERIFIED", "PASSED", "FAILED", "STALE"]},
        "lastVerified": {"type": ["string", "null"], "format": "date-time"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "buildEvidence": {"type": "array", "items": {"$ref": "#/definitions/buildEvidence"}},
          "serverEvidence": {"$ref": "#/definitions/serverEvidence"},
          "clientEvidence": {"$ref": "#/definitions/clientEvidence"},
          "integrationEvidence": {"$ref": "#/definitions/integrationEvidence"}
      }
    },
    "buildEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["minecraftId", "loaderId", "loaderVersion", "toolchain", "platform", "buildJavaRequirement", "observedBuildJava", "compilerTarget", "result", "artifactSha256", "verifiedAt", "fixtureProvenance"],
      "properties": {
        "minecraftId": {"type": "string", "minLength": 1},
        "loaderId": {"enum": ["Forge", "Fabric", "NeoForge", "Quilt", "LegacyFabric", "OrnitheLoader", "LiteLoader", "Rift", "ModLoader", "ModLoaderMP", "JarMod"]},
        "loaderVersion": {"type": "string", "minLength": 1},
        "toolchain": {"$ref": "#/definitions/toolchain"},
        "platform": {"type": "object", "additionalProperties": false, "required": ["os", "arch", "isWSL"], "properties": {"os": {"enum": ["Windows", "Linux", "MacOS"]}, "arch": {"enum": ["x64", "ARM64"]}, "isWSL": {"type": "boolean"}}},
        "buildJavaRequirement": {"$ref": "#/definitions/javaRequirement"},
        "observedBuildJava": {"type": "object", "additionalProperties": false, "required": ["major", "exactVersion", "vendor", "os", "arch"], "properties": {"major": {"type": "integer", "minimum": 1}, "exactVersion": {"type": "string", "minLength": 1}, "vendor": {"type": "string", "minLength": 1}, "os": {"enum": ["Windows", "Linux", "MacOS"]}, "arch": {"enum": ["x64", "ARM64"]}}},
        "compilerTarget": {"type": "object", "additionalProperties": false, "required": ["major", "source"], "properties": {"major": {"type": "integer", "minimum": 1}, "source": {"type": "string", "minLength": 1}}},
        "result": {"enum": ["PASSED", "FAILED", "UNVERIFIED", "STALE"]},
        "artifactSha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "fixtureProvenance": {"type": "object", "additionalProperties": false, "required": ["sourceUrl", "commit", "license"], "properties": {"sourceUrl": {"type": "string", "format": "uri"}, "commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"}, "license": {"type": "string", "minLength": 1}}}
      },
      "allOf": [{"if": {"properties": {"result": {"const": "PASSED"}}}, "then": {"properties": {"artifactSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}}}]
    },
    "serverEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["readyMarker", "readyMarkerMatched", "processIdentityMatched", "portListening", "stopMethod", "processExited", "portReleased"],
      "properties": {"readyMarker": {"type": "string", "minLength": 1}, "readyMarkerMatched": {"type": "boolean"}, "processIdentityMatched": {"type": "boolean"}, "portListening": {"type": "boolean"}, "stopMethod": {"enum": ["ConsoleStop", "Terminate"]}, "processExited": {"type": "boolean"}, "portReleased": {"type": "boolean"}}
    },
    "clientEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["initializationMarker", "initializationMarkerMatched", "processIdentityMatched", "liveAtMarker"],
      "properties": {"initializationMarker": {"type": "string", "minLength": 1}, "initializationMarkerMatched": {"type": "boolean"}, "processIdentityMatched": {"type": "boolean"}, "liveAtMarker": {"type": "boolean"}}
    },
    "integrationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario", "completed", "assertionsPassed"],
      "properties": {"scenario": {"type": "string", "minLength": 1}, "completed": {"type": "boolean"}, "assertionsPassed": {"type": "integer", "minimum": 0}}
    }
  }
}
