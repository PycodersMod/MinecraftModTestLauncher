{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/execution-plan.schema.json",
  "title": "MMTL Execution Plan",
  "description": "版本化的构建与运行计划；本机解析信息只存在于本地 Plan 实例。",
  "type": "object",
  "required": ["schemaVersion", "planId", "semanticDigest", "createdAt", "platform", "repository", "project", "buildJava", "runtimeJava", "profile", "build", "runtime", "network", "session", "capabilityGates", "blockingReasons", "warnings", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "planId": {"type": "string", "minLength": 1},
    "semanticDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "platform": {"$ref": "#/$defs/platform"},
    "repository": {"$ref": "#/$defs/repository"},
    "project": {"$ref": "#/$defs/project"},
    "buildJava": {"$ref": "#/$defs/javaTrack"},
    "runtimeJava": {"$ref": "#/$defs/runtimeJava"},
    "profile": {"$ref": "#/$defs/profile"},
    "build": {"$ref": "#/$defs/build"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "network": {"$ref": "#/$defs/network"},
    "session": {"type": "object", "required": ["intendedMode"], "properties": {"intendedMode": {"enum": ["Single", "IntegratedLAN", "Dedicated"]}}},
    "capabilityGates": {"type": "object", "required": ["buildReady", "launchReady"], "properties": {"buildReady": {"type": "boolean"}, "launchReady": {"type": "boolean"}, "buildReasons": {"type": "array", "items": {"type": "string"}}, "launchReasons": {"type": "array", "items": {"type": "string"}}}},
    "blockingReasons": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "platform": {"type": "object", "required": ["os", "arch", "isWSL", "capabilities"], "properties": {"os": {"enum": ["Windows", "Linux", "MacOS"]}, "arch": {"enum": ["x64", "ARM64"]}, "isWSL": {"type": "boolean"}, "capabilities": {"type": "object"}}},
    "repository": {"type": "object", "required": ["identity", "root"], "properties": {"identity": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}}},
    "project": {"type": "object", "required": ["projectRoot", "locator", "minecraftId", "loader", "loaderStack", "toolchain", "buildSystem"], "properties": {"projectRoot": {"type": "string", "minLength": 1}, "locator": {"type": "string"}, "minecraftId": {"type": "string", "minLength": 1}, "loader": {"$ref": "#/$defs/identityVersion"}, "loaderStack": {"type": "array"}, "toolchain": {"$ref": "#/$defs/identityVersion"}, "buildSystem": {"$ref": "#/$defs/identityVersion"}, "modId": {"type": ["string", "null"]}}},
    "identityVersion": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]}}},
    "javaRequirement": {"type": "object", "required": ["purpose", "major", "requirementKind", "source", "confidence"], "properties": {"purpose": {"enum": ["BuildJava", "RuntimeJava"]}, "major": {"type": ["integer", "null"], "minimum": 1}, "minimumMajor": {"type": ["integer", "null"], "minimum": 1}, "preferredMajor": {"type": ["integer", "null"], "minimum": 1}, "exactMajor": {"type": ["integer", "null"], "minimum": 1}, "requirementKind": {"type": "string"}, "source": {"type": "string", "minLength": 1}, "confidence": {"enum": ["High", "Medium", "Low", "Unknown"]}, "component": {"type": ["string", "null"]}, "provenance": {"type": ["array", "object", "string", "null"]}}},
    "javaResolution": {"type": "object", "required": ["status", "javaPath", "home", "actualMajor", "exactVersion", "vendor", "os", "arch", "reasonCode"], "properties": {"status": {"enum": ["Resolved", "Unresolved"]}, "javaPath": {"type": ["string", "null"]}, "home": {"type": ["string", "null"]}, "actualMajor": {"type": ["integer", "null"], "minimum": 1}, "exactVersion": {"type": ["string", "null"]}, "vendor": {"type": ["string", "null"]}, "os": {"type": "string"}, "arch": {"type": ["string", "null"]}, "reasonCode": {"type": ["string", "null"]}, "source": {"type": ["string", "null"]}}},
    "javaTrack": {"type": "object", "required": ["requirement", "resolution"], "properties": {"requirement": {"$ref": "#/$defs/javaRequirement"}, "resolution": {"$ref": "#/$defs/javaResolution"}}},
    "runtimeJava": {"type": "object", "required": ["requirement", "resolution", "bindingMode"], "properties": {"requirement": {"$ref": "#/$defs/javaRequirement"}, "resolution": {"$ref": "#/$defs/javaResolution"}, "bindingMode": {"enum": ["Direct", "ToolchainManaged", "SameAsBuildJvm", "Unsupported", "Unknown"]}}},
    "profile": {"type": "object", "required": ["name", "mode", "players"], "properties": {"name": {"type": "string"}, "mode": {"enum": ["Single", "IntegratedLAN", "Dedicated"]}, "players": {"type": "integer", "minimum": 1}, "jvmArgs": {"type": "array", "items": {"type": "string"}}, "gameArgs": {"type": "array", "items": {"type": "string"}}, "acceptEula": {"type": "boolean"}}},
    "build": {"type": "object", "required": ["required", "clean", "task", "wrapper", "artifactExpectation"], "properties": {"required": {"type": "boolean"}, "clean": {"type": "boolean"}, "task": {"type": "string"}, "wrapper": {"type": "string"}, "artifactExpectation": {"type": "string"}}},
    "runtime": {"type": "object", "required": ["roles", "runtimeDirectories", "memory", "jvmArgs", "gameArgs"], "properties": {"roles": {"type": "array", "items": {"type": "string"}}, "runtimeDirectories": {"type": "array", "items": {"type": "object", "required": ["role", "path"], "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "relativePath": {"type": "string"}}}}, "memory": {"type": "object"}, "jvmArgs": {"type": "array", "items": {"type": "string"}}, "gameArgs": {"type": "array", "items": {"type": "string"}}}},
    "network": {"type": "object", "required": ["portPolicy", "bindPolicy"], "properties": {"portPolicy": {"type": "string"}, "fixedPort": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}, "bindPolicy": {"type": "string"}}},
    "diagnostic": {"type": "object", "required": ["code", "action", "messageZh"], "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}, "action": {"enum": ["Build", "Launch", "Plan"]}, "messageZh": {"type": "string"}, "source": {"type": ["string", "null"]}}}
  }
}
