{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned Forge historical build dependency artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "resolver", "artifactStatus", "targetBuildStatus", "artifacts", "catalogHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targetId": {"const": "Forge@1.8"},
    "resolver": {"const": "Gradle 2.7 official MDK build cache capture"},
    "artifactStatus": {"enum": ["HashesVerified"]},
    "targetBuildStatus": {"enum": ["PendingRunnerValidation", "BuildVerified"]},
    "catalogHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group", "artifact", "version", "file", "extension", "bytes", "sha256", "url"],
        "properties": {
          "group": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "artifact": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
          "file": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.(jar|pom|zip)$"},
          "extension": {"enum": ["jar", "pom", "zip"]},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://(maven\\.minecraftforge\\.net|libraries\\.minecraft\\.net)/[A-Za-z0-9_./+-]+$"}
        }
      }
    }
  }
}
