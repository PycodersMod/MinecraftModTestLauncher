          "group": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "artifact": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 193,
      "maxItems": 195,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "group", "artifact", "version", "file", "extension", "bytes", "sha256", "url" ],
        "properties": {
          "group": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "artifact": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.(jar|pom)$" },
          "extension": { "enum": [ "jar", "pom" ] },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(maven\\.minecraftforge\\.net|libraries\\.minecraft\\.net|repo\\.maven\\.apache\\.org)/(maven2/)?[A-Za-z0-9_./+-]+\\.(jar|pom)$"
          }
        }
      }
    },
    "dynamicVersionResolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "group", "artifact", "selector", "resolvedVersion" ],
        "properties": {
          "group": { "const": "net.minecraftforge" },
          "artifact": { "enum": [ "artifactural", "legacydev" ] },
          "selector": { "enum": [ "1.0.+", "0.2.3.+" ] },
          "resolvedVersion": { "enum": [ "1.0.13", "0.2.3.1" ] }
        }
      }
    },
    "catalogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "targetId": { "const": "Forge@1.12.2" } }, "required": [ "targetId" ] },
      "then": { "properties": { "resolver": { "const": "ForgeGradle 3.0.197 buildscript closure plus userdev3 dynamic legacydev resolution" }, "dependencies": { "minItems": 13, "maxItems": 13 }, "artifacts": { "minItems": 195, "maxItems": 195 }, "dynamicVersionResolutions": { "minItems": 2, "maxItems": 2 } } }
    },
