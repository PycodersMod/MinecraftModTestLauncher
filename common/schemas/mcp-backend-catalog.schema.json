{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/mcp-backend-catalog.schema.json",
  "title": "MMTL Historical MCP Backend Candidate Catalog",
  "type": "object",
  "required": ["schemaVersion", "universeHash", "backendId", "backendSource", "versionRegistry", "executionPolicy", "targetPairs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "universeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "backendId": { "const": "retromcp-java" },
    "backendSource": {
      "type": "object",
      "required": ["repositoryUrl", "releaseTag", "commit", "runtimeJavaMajor"],
      "properties": {
        "repositoryUrl": { "const": "https://github.com/MCPHackers/RetroMCP-Java" },
        "releaseTag": { "const": "v1.2" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "runtimeJavaMajor": { "const": 8 }
      },
      "additionalProperties": false
    },
    "versionRegistry": {
      "type": "object",
      "required": ["url", "sha256", "byteLength", "recordCount", "retrievedAt"],
      "properties": {
        "url": { "const": "https://mcphackers.org/versionsV3/versions.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "recordCount": { "type": "integer", "minimum": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "executionPolicy": {
      "type": "object",
      "required": ["automaticDownloadAllowed", "automaticExecutionAllowed", "reason"],
      "properties": {
        "automaticDownloadAllowed": { "const": false },
        "automaticExecutionAllowed": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "targetPairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["loaderId", "minecraftId", "evidenceRefs"],
        "properties": {
          "loaderId": { "enum": ["ModLoader", "ModLoaderMP"] },
          "minecraftId": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^version-registry-id:.+" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
