{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MMTL sanitized exact-target Runtime Binding evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "targetId", "targetSpecHash", "loaderId", "minecraftId", "loaderVersion", "status", "probeStrategy", "evidenceSource", "confidence", "mode", "runtimeJavaControllable", "requiresBuildJvmMatch", "runtimeJavaMajor", "observedBuildJavaMajor", "observedBuildJavaVersion", "buildSystem", "toolchain", "tasks", "probeSourceSha256", "buildEvidenceSha256", "rawProbeEvidenceSha256", "platform"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "targetId": { "type": "string", "minLength": 1 },
    "targetSpecHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "loaderId": { "type": "string", "minLength": 1 },
    "minecraftId": { "type": "string", "minLength": 1 },
    "loaderVersion": { "type": "string", "minLength": 1 },
    "status": { "const": "Observed" },
    "probeStrategy": { "const": "GradleJavaExecTaskInspection" },
    "evidenceSource": { "const": "GradleInitScriptJavaExecInspection" },
    "confidence": { "const": "High" },
    "mode": { "enum": ["Direct", "SameAsBuildJvm", "ToolchainManaged"] },
    "runtimeJavaControllable": { "type": "boolean" },
    "requiresBuildJvmMatch": { "type": "boolean" },
    "runtimeJavaMajor": { "type": "integer", "minimum": 1, "maximum": 100 },
    "observedBuildJavaMajor": { "type": "integer", "minimum": 1, "maximum": 100 },
    "observedBuildJavaVersion": { "type": "string", "minLength": 1 },
    "buildSystem": { "$ref": "#/definitions/component" },
    "toolchain": { "$ref": "#/definitions/component" },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/task" } },
    "probeSourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "buildEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawProbeEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform": { "type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": { "os": { "enum": ["Windows", "Linux", "macOS"] }, "arch": { "enum": ["x64", "arm64"] } } }
  },
  "definitions": {
    "component": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "task": { "type": "object", "additionalProperties": false, "required": ["task", "taskType", "launcherSource", "executable"], "properties": { "task": { "enum": ["runClient", "runServer"] }, "taskType": { "type": "string", "pattern": "(^.*JavaExec.*$|^net\\.minecraftforge\\.gradle\\.common\\.util\\.runs\\.MinecraftRunTask(_Decorated)?$)" }, "isJavaExec": { "type": "boolean", "enum": [true] }, "launcherSource": { "type": "string", "minLength": 1 }, "executable": { "type": "string", "pattern": "^<(BUILD|RUNTIME)_JAVA_HOME>/bin/java(\\.exe)?$" } } }
  }
}
