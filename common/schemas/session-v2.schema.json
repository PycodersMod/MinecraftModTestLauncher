{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/session-v2.schema.json",
  "title": "MMTL Session Manifest v2",
  "type": "object",
  "required": ["schemaVersion", "sessionId", "state", "createdUtc", "updatedUtc", "planFile", "planDigest", "planSha256", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sessionId": {"type": "string", "minLength": 1},
    "state": {"enum": ["Created", "Preparing", "Building", "Launching", "Running", "Completed", "Failed", "Stopped", "Abandoned"]},
    "createdUtc": {"type": "string", "format": "date-time"},
    "updatedUtc": {"type": "string", "format": "date-time"},
    "planFile": {"const": "execution-plan.json"},
    "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "planSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "kind"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "kind": {"type": "string"}}}},
    "identityBindingRequired": {"type": "boolean"},
    "identityBindings": {"type": "array", "items": {"type": "object", "required": ["identityId", "instanceId", "role", "gameDir", "offline"], "properties": {"identityId": {"type": "string", "minLength": 1}, "instanceId": {"type": "string", "minLength": 1}, "role": {"enum": ["Client", "Host", "Guest", "Server"]}, "username": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_]{1,16}$"}, "gameDir": {"type": "string", "minLength": 1}, "runtimeJavaMajor": {"type": ["integer", "null"], "minimum": 1}, "runtimeJavaPath": {"type": ["string", "null"]}, "minecraftVersion": {"type": ["string", "null"], "maxLength": 64}, "offline": {"const": true}}}}
  },
  "x-state-transitions": {
    "Created": ["Preparing", "Building", "Launching", "Failed", "Abandoned"],
    "Preparing": ["Building", "Launching", "Failed", "Abandoned"],
    "Building": ["Launching", "Completed", "Failed", "Abandoned"],
    "Launching": ["Running", "Failed", "Abandoned"],
    "Running": ["Completed", "Failed", "Stopped", "Abandoned"],
    "Completed": [],
    "Failed": [],
    "Stopped": [],
    "Abandoned": []
  }
}
