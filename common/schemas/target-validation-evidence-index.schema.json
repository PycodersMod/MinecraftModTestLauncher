{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/minecraftmodtestlauncher/schemas/target-validation-evidence-index.schema.json",
  "title": "MMTL exact-target validation evidence index",
  "type": "object",
  "required": ["schemaVersion", "universeHash", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "universeHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetId", "dimension", "targetSpecHash", "evidencePath", "evidenceSha256"],
        "properties": {
          "targetId": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["BuildExact", "BuildVerified", "RuntimeBinding", "AgentBuild", "AgentInjection", "AgentApplicability", "DedicatedApplicability", "LaunchCheck", "ClientLaunch", "MultiWindow", "SingleAssertion", "MultiplayerJoinAndAssertion", "Multiplayer", "TargetReport", "SafeStop", "DedicatedServer", "NativeIntegratedLAN", "HistoricalDedicatedEquivalent"]},
          "targetSpecHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "adapterSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "toolchainHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evidencePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^:]+$"},
          "evidenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
