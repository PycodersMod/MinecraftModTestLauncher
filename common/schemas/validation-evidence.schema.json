{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/minecraftmodtestlauncher/schemas/validation-evidence.schema.json",
  "title": "MMTL 不可变验证运行证据",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "runId", "startedAt", "endedAt", "durationSeconds", "validationLevel", "result", "failureCode", "platform", "java", "toolchain", "buildSystem", "sourceFixture", "logs", "artifact", "process", "marker", "stopMethod", "scenario", "notes"],
  "properties": {
    "schemaVersion": {"const": 1}, "targetId": {"type": "string", "minLength": 3}, "minecraftId": {"type": "string", "minLength": 1}, "loaderId": {"type": "string", "minLength": 1}, "loaderVersion": {"type": "string", "minLength": 1}, "runId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "startedAt": {"type": "string", "format": "date-time"}, "endedAt": {"type": "string", "format": "date-time"}, "durationSeconds": {"type": "number", "minimum": 0},
    "validationLevel": {"enum": ["RESOLVED", "BUILD_VERIFIED", "SERVER_VERIFIED", "CLIENT_LAUNCH_VERIFIED", "INTEGRATION_VERIFIED"]},
    "result": {"enum": ["PASSED", "FAILED", "BLOCKED", "SKIPPED"]}, "failureCode": {"type": "string", "enum": ["NONE", "RESOLVE_FAILED", "BUILD_FAILED_PROJECT_SOURCE", "BUILD_FAILED_MMTL", "BUILD_FAILED_TOOLCHAIN", "BUILD_FAILED_NETWORK", "BUILD_TIMEOUT", "BUILD_JAVA_UNAVAILABLE", "RUNTIME_JAVA_UNAVAILABLE", "SERVER_EULA_REQUIRED", "SERVER_READY_TIMEOUT", "CLIENT_AUTH_REQUIRED", "CLIENT_LAUNCH_TIMEOUT", "CLIENT_CRASH", "UPSTREAM_UNAVAILABLE", "PLATFORM_UNSUPPORTED", "UNTRUSTED_FIXTURE_REJECTED", "ARTIFACT_MISSING", "EVIDENCE_INVALID"]},
    "platform": {"type": "object", "additionalProperties": false, "required": ["os", "arch", "isWSL"], "properties": {"os": {"enum": ["Windows", "Linux", "MacOS"]}, "arch": {"enum": ["x64", "ARM64"]}, "isWSL": {"type": "boolean"}}},
    "java": {"type": "object", "additionalProperties": false, "required": ["buildRequirement", "observedBuildJava", "compilerTarget", "runtimeRequirement", "observedRuntimeJava"], "properties": {"buildRequirement": {"type": ["object", "null"]}, "observedBuildJava": {"type": ["object", "null"]}, "compilerTarget": {"type": ["integer", "null"], "minimum": 1}, "runtimeRequirement": {"type": ["object", "null"]}, "observedRuntimeJava": {"type": ["object", "null"]}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]}}},
    "buildSystem": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": ["string", "null"]}}},
    "sourceFixture": {"type": "object", "additionalProperties": false, "required": ["type", "source", "commit", "license", "trust"], "properties": {"type": {"enum": ["UserProject", "OfficialFixture", "OfficialArtifactFixture", "GeneratedOfficialFixture", "HistoricalOfficialFixture", "CIHosted", "LocalPhysical", "WSL", "ImportedHistoricalEvidence"]}, "source": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}, "archiveSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "officialChecksum": {"type": "string", "pattern": "^[a-fA-F0-9]{32,64}$"}, "officialChecksumAlgorithm": {"enum": ["MD5", "SHA1", "SHA256"]}, "license": {"type": "string", "minLength": 1}, "trust": {"enum": ["UserOwned", "TrustedOfficial", "VerifiedHistorical", "UnverifiedHistorical", "Unknown"]}}},
    "logs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\\\\\)"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}}},
    "artifact": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "filename", "sizeBytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "filename": {"type": "string", "minLength": 1}, "sizeBytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
    "process": {"type": ["object", "null"], "additionalProperties": false, "required": ["identityMatched", "liveAtMarker", "exited", "exitCode", "portListening", "portReleased"], "properties": {"identityMatched": {"type": "boolean"}, "liveAtMarker": {"type": "boolean"}, "exited": {"type": "boolean"}, "exitCode": {"type": ["integer", "null"]}, "portListening": {"type": ["boolean", "null"]}, "portReleased": {"type": ["boolean", "null"]}}},
    "marker": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "text", "matched", "elapsedSeconds"], "properties": {"kind": {"enum": ["serverReady", "clientInitialized", "integration"]}, "text": {"type": "string", "minLength": 1}, "matched": {"type": "boolean"}, "elapsedSeconds": {"type": ["number", "null"], "minimum": 0}}},
    "stopMethod": {"type": ["string", "null"], "enum": ["ConsoleStop", "Terminate", "CloseWindow", "NotApplicable", null]},
    "scenario": {"type": ["object", "null"], "additionalProperties": false, "required": ["name", "completed", "assertionsPassed"], "properties": {"name": {"type": "string", "minLength": 1}, "completed": {"type": "boolean"}, "assertionsPassed": {"type": "integer", "minimum": 0}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
