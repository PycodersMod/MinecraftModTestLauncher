{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestHash", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "projectPath", "loaderVersion", "wrapper", "task", "sourceFixture"],
        "properties": {
          "targetId": {"type": "string", "minLength": 2, "maxLength": 180},
          "projectPath": {"type": "string", "minLength": 1},
          "loaderVersion": {"type": "string", "minLength": 1},
          "wrapper": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "sourceFixture": {
            "type": "object",
            "required": ["type", "allowedTasks"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "allowedTasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "agentHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "javaMajor": {"type": "integer", "minimum": 1, "maximum": 100},
          "toolchain": {"type": "string", "minLength": 1},
          "toolchainVersion": {"type": "string", "minLength": 1},
          "buildSystem": {"type": "string", "minLength": 1},
          "buildSystemVersion": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
