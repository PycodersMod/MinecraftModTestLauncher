{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pycodersmod.github.io/MinecraftModTestLauncher/schemas/exception-registry.schema.json",
  "title": "MMTL Exception Registry v1",
  "description": "Central, reviewable rules for historical compatibility and platform exceptions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "exceptions": {"type": "array", "items": {"$ref": "#/definitions/exception"}}
  },
  "definitions": {
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceType", "url", "fetchedAt"],
      "properties": {
        "sourceType": {"enum": ["official", "archivedOfficial", "trustedArchive", "communityMirror", "unknown"]},
        "url": {"type": "string", "format": "uri"},
        "fetchedAt": {"type": "string", "format": "date-time"},
        "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "archiveStatus": {"enum": ["active", "archived", "unverified", "unknown"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "matcher", "rule", "reason", "provenance", "appliesTo", "lastReviewed", "reviewPolicy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "matcher": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "rule": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "reason": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/provenance"}},
        "appliesTo": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "lastReviewed": {"type": "string", "format": "date"},
        "reviewPolicy": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    }
  }
}
