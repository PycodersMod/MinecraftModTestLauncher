{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmtl.local/schemas/historical-provenance.schema.json",
  "title": "MMTL Historical Source and Artifact Evidence",
  "type": "object",
  "required": ["schemaVersion", "sourceClass", "trustClass", "transportSecurity", "maintenanceState", "integrity", "downloadPermission", "executePermission", "retrievedAt", "lastReviewed", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceClass": {"enum": ["ActiveOfficial", "HistoricalOfficial", "VerifiedCommunityArchive", "VerifiedCommunitySource", "ManualArtifact", "UnknownHistorical"]},
    "trustClass": {"enum": ["TrustedOfficial", "VerifiedHistorical", "UnverifiedHistorical"]},
    "transportSecurity": {"enum": ["HTTPS", "HTTPOnly", "LocalManual", "ArchivedSnapshot", "Unknown"]},
    "maintenanceState": {"enum": ["Active", "Limited", "Archived", "Dead", "Unknown"]},
    "integrity": {"type": "object", "required": ["algorithm", "strength"], "properties": {"algorithm": {"enum": ["SHA256", "SHA1", "MD5", "None", "Unknown"]}, "hash": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]+$"}, "strength": {"enum": ["StrongIntegrity", "LegacyIntegrity", "CorruptionDetectionOnly", "NoIntegrity", "Unknown"]}}, "additionalProperties": false},
    "downloadPermission": {"enum": ["Granted", "RequiresConfirmation", "Denied"]},
    "executePermission": {"enum": ["Granted", "RequiresConfirmation", "Denied"]},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "lastReviewed": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sourceType"], "properties": {"url": {"type": ["string", "null"], "format": "uri"}, "path": {"type": ["string", "null"]}, "source": {"type": ["string", "null"]}, "sourceType": {"enum": ["official", "archivedOfficial", "trustedArchive", "communityMirror", "manual", "unknown"]}, "commit": {"type": ["string", "null"], "pattern": "^([0-9a-fA-F]{40})?$"}, "sha256": {"type": ["string", "null"], "pattern": "^([0-9a-fA-F]{64})?$"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
